{
  "name": "vegyfresh-workspace",
  "private": true,
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "dev": "pnpm -r --parallel --if-present run dev",
    "lint": "pnpm -r --if-present run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "pnpm -r --if-present run check-types",
    "test": "pnpm --filter backend test --runInBand && pnpm -r --filter '!backend' --if-present run test",
    "check": "pnpm lint && pnpm check-types && pnpm test && pnpm build",
    "seed:api": "pnpm --filter @vegyfresh/seed-api run seed"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@10.11.0"
}
