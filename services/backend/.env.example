AI_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=
GEMINI_API_KEY=
GEMINI_BASE_URL=

WHATSAPP_BOT_USER_ID=

# Keycloak is the only API identity provider.
AUTH_PROVIDER=keycloak
KEYCLOAK_ISSUER=http://localhost:8080/realms/vegyfresh
KEYCLOAK_AUDIENCE=vegyfresh-api
KEYCLOAK_ADMIN_CLIENT_ID=vegyfresh-admin
KEYCLOAK_PORTAL_CLIENT_ID=vegyfresh-portal
KEYCLOAK_ADMIN_SCOPE=vegyfresh-api
KEYCLOAK_PORTAL_SCOPE=vegyfresh-portal
