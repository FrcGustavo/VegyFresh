# Local development only. Copy this file to .env and fill in the credentials.
SEED_API_BASE_URL=http://host.docker.internal:3000/api/v1
SEED_KEYCLOAK_TOKEN_URL=http://host.docker.internal:8080/realms/vegyfresh/protocol/openid-connect/token
SEED_KEYCLOAK_CLIENT_ID=vegyfresh-admin
SEED_KEYCLOAK_USERNAME=
SEED_KEYCLOAK_PASSWORD=

# Optional: provide an access token directly instead of Keycloak credentials.
SEED_API_BEARER_TOKEN=

# Passwords assigned to generated API user records.
SEED_ADMIN_PASSWORD=seed_admin_password_change_me
SEED_OPERATOR_PASSWORD=seed_operator_password_change_me

SEED_CONCURRENCY=10
SEED_TRANSACTIONAL_CONCURRENCY=3
