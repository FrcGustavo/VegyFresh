# Server configuration; never expose credentials through VITE_ variables.
VEGYFRESH_API_URL=http://host.docker.internal:3000
VEGYFRESH_PUBLIC_ORIGIN=http://localhost:5174
HOST=0.0.0.0
PORT=5174

# Use the portal client and realm configured in Keycloak.
KEYCLOAK_ISSUER=http://localhost:8080/realms/vegyfresh
KEYCLOAK_INTERNAL_URL=http://host.docker.internal:8080/realms/vegyfresh
KEYCLOAK_CLIENT_ID=vegyfresh-portal
# Public PKCE clients omit a secret. Configure this only for confidential clients.
KEYCLOAK_CLIENT_SECRET=
# Generate independent high-entropy secrets for the two app servers (>=32 bytes).
VEGYFRESH_SESSION_SECRET=
