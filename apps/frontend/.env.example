# Server configuration; never expose credentials through VITE_ variables.
VEGYFRESH_API_URL=http://localhost:3000
VEGYFRESH_PUBLIC_ORIGIN=http://localhost:5173
HOST=127.0.0.1
PORT=5173

# Keycloak is the only supported authentication provider.
KEYCLOAK_ISSUER=http://localhost:8080/realms/vegyfresh
KEYCLOAK_CLIENT_ID=vegyfresh-admin
# Public PKCE clients omit a secret. Configure this only for confidential clients.
KEYCLOAK_CLIENT_SECRET=
# Set this only when the runtime needs a container-internal discovery URL.
# KEYCLOAK_INTERNAL_URL=http://keycloak:8080/realms/vegyfresh
# Generate independent high-entropy secrets for the two app servers (>=32 bytes).
VEGYFRESH_SESSION_SECRET=

# Used by clients/api-client when regenerating OpenAPI types, not by the frontend runtime.
# API_SCHEMA_URL=http://localhost:3000/api/docs-json
