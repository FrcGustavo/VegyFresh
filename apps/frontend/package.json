{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.start.config.ts --host 0.0.0.0 --port 5173 --strictPort",
    "build": "tsc -b && vite build --config vite.start.config.ts",
    "check-types": "tsc -b",
    "generate:api-types": "pnpm --filter @vegyfresh/api-client generate:api-types",
    "lint": "pnpm run check:architecture && eslint .",
    "test": "node --test scripts/check-architecture.test.mjs && vitest run --exclude 'tests/*.test.mjs' --exclude 'scripts/*.test.mjs' && node --test tests/adminRoutes.test.mjs tests/apiProxy.test.mjs",
    "preview": "pnpm run start",
    "dev:start": "vite --config vite.start.config.ts --host 0.0.0.0 --port 5173 --strictPort",
    "build:start": "vite build --config vite.start.config.ts",
    "serve:start": "node .output/server/index.mjs",
    "test:start": "node --test tests/start-runtime.test.mjs",
    "start": "node .output/server/index.mjs",
    "build:spa": "tsc -b && vite build",
    "check:architecture": "node scripts/check-architecture.mjs"
  },
  "dependencies": {
    "@vegyfresh/api-client": "workspace:*",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/roboto": "^5.2.10",
    "@mui/icons-material": "^9.0.0",
    "@mui/material": "^9.0.0",
    "@tanstack/react-query": "^5.100.5",
    "openid-client": "^6.8.8",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router": "^7.14.2",
    "zustand": "^5.0.13",
    "@tanstack/react-router": "^1.169.5",
    "@tanstack/react-start": "^1.169.5"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "jsdom": "^29.1.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vitest": "^4.1.7",
    "nitro": "3.0.261103-rc"
  }
}
