# Auth0 development tenant. Use the issuer exactly as it appears in discovery.
OIDC_ISSUER=https://your-tenant.example.auth0.com/
OIDC_JWKS_URI=https://your-tenant.example.auth0.com/.well-known/jwks.json
OIDC_API_AUDIENCE=https://api.vegyfresh.example
# Auth0 uses audience. Providers supporting RFC 8707 can use resource.
OIDC_API_RESOURCE_PARAMETER=audience
OIDC_ADMIN_CLIENT_ID=
OIDC_ADMIN_CLIENT_SECRET=
OIDC_PORTAL_CLIENT_ID=
OIDC_PORTAL_CLIENT_SECRET=

# Generate each of these independently with openssl rand -hex 32.
OIDC_PROVISIONING_SECRET=
VEGYFRESH_ADMIN_SESSION_SECRET=
VEGYFRESH_PORTAL_SESSION_SECRET=
